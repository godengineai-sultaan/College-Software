# WSchools Fee Management System — Nginx reverse proxy (sample)
#
# Terminates TLS and forwards to the Node app (Nginx + Node.js, per the
# infrastructure plan). Set TRUST_PROXY=1 in the app's environment so secure
# cookies and correct client IPs work behind this proxy.
#
# Replace server_name and the certificate paths, then:
#   sudo nginx -t && sudo systemctl reload nginx

# Redirect all HTTP to HTTPS.
server {
    listen 80;
    server_name fees.your-college.edu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name fees.your-college.edu;

    # --- TLS ---
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # --- Uploads (bill attachments / photos) ---
    client_max_body_size 12m;

    # --- Compression ---
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # --- Proxy to the Node app ---
    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 60s;
    }

    # Serve static assets efficiently with a cache header.
    location /css/  { proxy_pass http://127.0.0.1:3000; expires 7d; add_header Cache-Control "public"; }
    location /js/   { proxy_pass http://127.0.0.1:3000; expires 7d; add_header Cache-Control "public"; }

    # Health endpoint for external monitors.
    location = /health { proxy_pass http://127.0.0.1:3000/health; access_log off; }
}
