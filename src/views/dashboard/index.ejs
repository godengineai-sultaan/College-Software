<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <div class="sub">
      <%= branchId ? ('Branch ' + currentUser.branch_code + ' · ' + currentUser.branch_name) : 'All branches consolidated' %>
      · <%= settings.academic_year %>
    </div>
  </div>
  <div class="btn-group">
    <% if (can('collection')) { %><a href="/collection" class="btn"><%- icon('money') %> Collect Fee</a><% } %>
    <% if (can('reports')) { %><a href="/reports" class="btn secondary"><%- icon('chart') %> Reports</a><% } %>
  </div>
</div>

<!-- KPI tiles -->
<div class="stats">
  <div class="stat">
    <div class="stat__icon i-indigo"><%- icon('students', 22) %></div>
    <div><div class="stat__val"><%= d.students.toLocaleString('en-IN') %></div><div class="stat__label">Active Students</div></div>
  </div>
  <div class="stat">
    <div class="stat__icon i-green"><%- icon('money', 22) %></div>
    <div><div class="stat__val"><%= h.money(d.monthCollection, currency) %></div><div class="stat__label">Collected This Month</div></div>
  </div>
  <div class="stat">
    <div class="stat__icon i-sky"><%- icon('clock', 22) %></div>
    <div><div class="stat__val"><%= h.money(d.todayCollection, currency) %></div><div class="stat__label">Collected Today</div></div>
  </div>
  <div class="stat">
    <div class="stat__icon i-red"><%- icon('fees', 22) %></div>
    <div><div class="stat__val"><%= h.money(d.outstanding, currency) %></div><div class="stat__label">Outstanding Dues</div></div>
  </div>
</div>

<div class="stats">
  <div class="stat">
    <div class="stat__icon i-green"><%- icon('download', 22) %></div>
    <div><div class="stat__val"><%= h.money(d.totalCollection, currency) %></div><div class="stat__label">Total Collections</div></div>
  </div>
  <div class="stat">
    <div class="stat__icon i-amber"><%- icon('building', 22) %></div>
    <div><div class="stat__val"><%= h.money(d.totalExpense, currency) %></div><div class="stat__label">Total Expenses</div></div>
  </div>
  <div class="stat">
    <div class="stat__icon <%= d.netCollection >= 0 ? 'i-indigo' : 'i-red' %>"><%- icon('chart', 22) %></div>
    <div><div class="stat__val"><%= h.money(d.netCollection, currency) %></div><div class="stat__label">Net Collection (Coll − Exp)</div></div>
  </div>
  <div class="stat">
    <div class="stat__icon i-sky"><%- icon('timetable', 22) %></div>
    <div><div class="stat__val"><%= d.sync.committed || 0 %></div><div class="stat__label">Cross-Branch Syncs</div></div>
  </div>
</div>

<div class="grid-2">
  <!-- Monthly collection -->
  <div class="card">
    <div class="card__head"><h3>Monthly Collection Trend</h3></div>
    <div class="card__body">
      <%- include('../partials/bars', { items: d.monthly.map(function(m){ return { label: m.ym, value: m.total, sub: h.money(m.total, currency) }; }) }) %>
    </div>
  </div>

  <!-- Payment mode distribution -->
  <div class="card">
    <div class="card__head"><h3>Payment Mode Distribution</h3></div>
    <div class="card__body">
      <%- include('../partials/bars', { items: d.modeDist.map(function(m){ return { label: labelFor(constants.PAYMENT_MODES, m.payment_mode), value: m.total, sub: h.money(m.total, currency) + ' · ' + m.count, color: '#0ea5e9' }; }) }) %>
    </div>
  </div>
</div>

<div class="grid-2">
  <!-- Fee status breakdown -->
  <div class="card">
    <div class="card__head"><h3>Fee Status Breakdown</h3></div>
    <div class="card__body">
      <% const fsTotal = (d.feeStatus.unpaid + d.feeStatus.partial + d.feeStatus.paid + d.feeStatus.waived) || 1; %>
      <div class="tag-list" style="margin-bottom:14px;">
        <span class="badge green">Paid <%= d.feeStatus.paid %></span>
        <span class="badge amber">Partial <%= d.feeStatus.partial %></span>
        <span class="badge red">Unpaid <%= d.feeStatus.unpaid %></span>
        <span class="badge gray">Waived <%= d.feeStatus.waived %></span>
      </div>
      <%- include('../partials/bars', { max: fsTotal, items: [
        { label: 'Paid', value: d.feeStatus.paid, sub: d.feeStatus.paid + ' lines', color: '#16a34a' },
        { label: 'Partial', value: d.feeStatus.partial, sub: d.feeStatus.partial + ' lines', color: '#d97706' },
        { label: 'Unpaid', value: d.feeStatus.unpaid, sub: d.feeStatus.unpaid + ' lines', color: '#dc2626' },
      ] }) %>
    </div>
  </div>

  <!-- Collection by course -->
  <div class="card">
    <div class="card__head"><h3>Collection by Course</h3></div>
    <div class="card__body">
      <%- include('../partials/bars', { items: d.byCourse.map(function(c){ return { label: c.course || '—', value: c.total, sub: h.money(c.total, currency), color: '#4f46e5' }; }) }) %>
    </div>
  </div>
</div>

<!-- Branch comparison (all-branch roles only) -->
<% if (d.branchCompare) { %>
<div class="card">
  <div class="card__head"><h3>Branch Comparison</h3></div>
  <div class="card__body tight">
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Branch</th><th>Students</th><th class="text-right">Collected</th><th class="text-right">Expenses</th><th class="text-right">Net</th></tr></thead>
        <tbody>
          <% d.branchCompare.forEach(function(b){ %>
            <tr>
              <td><span class="badge indigo">Branch <%= b.branch_code %></span> <%= b.name %></td>
              <td><%= b.students %></td>
              <td class="text-right"><%= h.money(b.collected, currency) %></td>
              <td class="text-right"><%= h.money(b.spent, currency) %></td>
              <td class="text-right"><strong><%= h.money(b.collected - b.spent, currency) %></strong></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<div class="grid-2">
  <!-- Recent receipts -->
  <div class="card">
    <div class="card__head"><h3>Recent Receipts</h3><a href="/receipts" class="btn sm secondary">View all</a></div>
    <div class="card__body tight">
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Receipt</th><th>Student</th><th class="text-right">Amount</th><th>Mode</th></tr></thead>
          <tbody>
            <% if (!d.recent.length) { %><tr><td colspan="4" class="text-center muted" style="padding:24px;">No receipts yet.</td></tr><% } %>
            <% d.recent.forEach(function(r){ %>
              <tr>
                <td><a href="/receipts/<%= r.id %>"><%= r.receipt_no %></a> <% if (r.cross_branch) { %><span class="badge blue">X-Branch</span><% } %></td>
                <td><%= r.student_name %><br><span class="muted small"><%= r.student_uid %></span></td>
                <td class="text-right"><%= h.money(r.amount, currency) %></td>
                <td><span class="badge gray"><%= labelFor(constants.PAYMENT_MODES, r.payment_mode) %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Defaulters -->
  <div class="card">
    <div class="card__head"><h3>Top Defaulters</h3><a href="/reports/defaulters" class="btn sm secondary">Full list</a></div>
    <div class="card__body tight">
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Student</th><th>Course</th><th class="text-right">Due</th></tr></thead>
          <tbody>
            <% if (!d.defaulters.length) { %><tr><td colspan="3" class="text-center muted" style="padding:24px;">No dues pending. 🎉</td></tr><% } %>
            <% d.defaulters.forEach(function(s){ %>
              <tr>
                <td><a href="/students/<%= s.id %>"><%= s.name %></a><br><span class="muted small"><%= s.unique_id %></span></td>
                <td><%= s.course_name || '—' %><br><span class="muted small">Sem <%= s.semester %></span></td>
                <td class="text-right"><strong style="color:var(--danger)"><%= h.money(s.due, currency) %></strong></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
