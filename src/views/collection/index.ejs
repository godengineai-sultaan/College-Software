<div class="page-head">
  <div><h1>Fee Collection</h1><div class="sub">Search a student, review dues and record a payment. Cross-branch collection supported.</div></div>
</div>

<!-- Step 1: search -->
<div class="card">
  <div class="card__body">
    <form class="toolbar" method="GET" action="/collection">
      <div class="search-box" style="flex:1;">
        <span class="ic"><%- icon('search', 16) %></span>
        <input type="text" name="q" value="<%= q || '' %>" placeholder="Search by name, student ID or phone (any branch)..." autofocus>
      </div>
      <button class="btn"><%- icon('search',16) %> Search</button>
    </form>
  </div>
</div>

<% if (!student && q) { %>
  <div class="card">
    <div class="card__head"><h3><%= results.length %> match<%= results.length===1?'':'es' %></h3></div>
    <div class="card__body tight">
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Student ID</th><th>Name</th><th>Course</th><th>Branch</th><th>Phone</th><th></th></tr></thead>
          <tbody>
            <% if (!results.length) { %><tr><td colspan="6"><div class="empty"><div class="big">🔎</div><h3>No students found</h3></div></td></tr><% } %>
            <% results.forEach(function(s){ %>
              <tr>
                <td><strong><%= s.unique_id %></strong></td>
                <td><%= s.name %></td>
                <td><%= s.course_disp || s.course_name || '—' %> · Sem <%= s.semester %></td>
                <td><span class="badge indigo"><%= s.branch_code %></span></td>
                <td class="muted"><%= s.phone || '—' %></td>
                <td><a class="btn sm" href="/collection?student=<%= s.id %>"><%- icon('money',14) %> Collect</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<% if (student && summary) {
     const crossBranch = !branchScopeId ? false : (student.branch_id !== branchScopeId);
     const scopedCross = branchScopeId && student.branch_id !== branchScopeId;
%>
  <div class="grid-2">
    <!-- Student & dues -->
    <div class="card">
      <div class="card__head"><h3>Student</h3><a href="/students/<%= student.id %>" class="btn sm ghost">Open profile</a></div>
      <div class="card__body">
        <div class="profile-head" style="margin-bottom:12px;">
          <div class="profile-photo"><%= (student.name||'?').charAt(0).toUpperCase() %></div>
          <div>
            <h3 style="margin:0;"><%= student.name %></h3>
            <div class="tag-list" style="margin-top:5px;">
              <span class="badge indigo"><%= student.unique_id %></span>
              <span class="badge blue">Branch <%= student.branch_code %></span>
              <span class="badge gray"><%= student.course_disp || student.course_name || '—' %> · Sem <%= student.semester %></span>
            </div>
          </div>
        </div>
        <% if (scopedCross) { %>
          <div class="alert warning"><span>⚠ <strong>Cross-branch payment.</strong> This Branch <%= student.branch_code %> student is paying at your Branch <%= currentUser.branch_code %> desk. The receipt is recorded here and mirrored to Branch <%= student.branch_code %>.</span></div>
        <% } %>
        <div class="stats" style="grid-template-columns:1fr 1fr;">
          <div class="stat"><div><div class="stat__val" style="font-size:19px;"><%= h.money(summary.net, currency) %></div><div class="stat__label">Payable</div></div></div>
          <div class="stat"><div><div class="stat__val" style="font-size:19px; color:var(--danger)"><%= h.money(summary.due, currency) %></div><div class="stat__label">Balance Due</div></div></div>
        </div>
        <div class="table-wrap" style="margin-top:6px;">
          <table class="data">
            <thead><tr><th>Head</th><th class="text-right">Due</th></tr></thead>
            <tbody>
              <% summary.lines.filter(function(l){return l.balance>0;}).forEach(function(l){ %>
                <tr><td><%= l.fee_head %><% if (l.late_fee) { %> <span class="badge amber">+<%= h.money(l.late_fee,currency) %> late</span><% } %></td><td class="text-right"><%= h.money(l.balance,currency) %></td></tr>
              <% }); %>
              <% if (summary.due<=0) { %><tr><td colspan="2" class="text-center muted" style="padding:18px;">All dues cleared 🎉</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Payment form -->
    <div class="card">
      <div class="card__head"><h3>Record Payment</h3></div>
      <div class="card__body">
        <% if (summary.due <= 0) { %>
          <div class="empty"><div class="big">✅</div><h3>No dues pending</h3><p>This student has cleared all fees.</p></div>
        <% } else if (!canManage('collection')) { %>
          <div class="alert info"><span>Your role can view collection but not record payments.</span></div>
        <% } else { %>
          <form action="/collection" method="POST">
            <%- csrfField() %>
            <input type="hidden" name="student_id" value="<%= student.id %>">
            <div class="field" style="margin-bottom:14px;">
              <label>Amount to collect <span class="req">*</span></label>
              <input type="number" step="0.01" min="0.01" max="<%= summary.due.toFixed(2) %>" name="amount" value="<%= summary.due.toFixed(2) %>" required>
              <span class="hint">Maximum <%= h.money(summary.due, currency) %>. Allocated to oldest dues first, head-wise.</span>
            </div>
            <div class="field" style="margin-bottom:14px;">
              <label>Payment mode <span class="req">*</span></label>
              <select name="payment_mode" required>
                <% constants.PAYMENT_MODES.forEach(function(m){ %><option value="<%= m.value %>"><%= m.label %></option><% }); %>
              </select>
            </div>
            <div class="field" style="margin-bottom:14px;">
              <label>Reference No. <span class="muted">(txn / cheque / DD no.)</span></label>
              <input name="reference_no" placeholder="Optional for cash">
            </div>
            <% if (!branchScopeId && collectBranches.length > 1) { %>
              <div class="field" style="margin-bottom:14px;">
                <label>Collecting branch</label>
                <select name="collecting_branch_id">
                  <% collectBranches.forEach(function(b){ %><option value="<%= b.id %>" <%= b.id===defaultCollectBranchId?'selected':'' %>>Branch <%= b.branch_code %> — <%= b.name %></option><% }); %>
                </select>
                <span class="hint">If different from the student's branch, it is recorded as a cross-branch payment.</span>
              </div>
            <% } %>
            <div class="field" style="margin-bottom:14px;"><label>Payment date</label><input type="date" name="paid_on" value="<%= h.formatDate ? new Date().toISOString().slice(0,10) : '' %>"></div>
            <div class="field" style="margin-bottom:16px;"><label>Remarks</label><input name="remarks" placeholder="Optional"></div>
            <button class="btn success block"><%- icon('check') %> Collect & Generate Receipt</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
<% } %>
