<div class="page-head">
  <div>
    <h1>Students</h1>
    <div class="sub"><%= total.toLocaleString('en-IN') %> student<%= total === 1 ? '' : 's' %><%= branchScopeId ? ' · Branch ' + currentUser.branch_code : '' %></div>
  </div>
  <div class="btn-group">
    <% if (canManage('students')) { %>
      <a href="/students/trash" class="btn secondary"><%- icon('trash') %> Trash<% if (trashCount) { %> (<%= trashCount %>)<% } %></a>
      <a href="/students/bulk" class="btn secondary"><%- icon('download') %> Bulk Upload</a>
      <a href="/students/new" class="btn"><%- icon('plus') %> Add Student</a>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="card__body" style="padding-bottom:6px;">
    <form class="toolbar" method="GET" action="/students">
      <div class="search-box">
        <span class="ic"><%- icon('search', 16) %></span>
        <input type="text" name="q" value="<%= query.q || '' %>" placeholder="Search name, ID, phone...">
      </div>
      <% if (!branchScopeId && branches.length > 1) { %>
        <select name="branch" onchange="this.form.submit()">
          <option value="">All Branches</option>
          <% branches.forEach(function(b){ %><option value="<%= b.id %>" <%= String(query.branch)==String(b.id)?'selected':'' %>>Branch <%= b.branch_code %> — <%= b.name %></option><% }); %>
        </select>
      <% } %>
      <select name="course" onchange="this.form.submit()">
        <option value="">All Courses</option>
        <% courses.forEach(function(c){ %><option value="<%= c.id %>" <%= String(query.course)==String(c.id)?'selected':'' %>><%= c.name %></option><% }); %>
      </select>
      <select name="status" onchange="this.form.submit()">
        <option value="">Any Status</option>
        <% statuses.forEach(function(s){ %><option value="<%= s.value %>" <%= query.status===s.value?'selected':'' %>><%= s.label %></option><% }); %>
      </select>
      <button class="btn secondary sm">Filter</button>
      <% if (query.q || query.course || query.status || query.branch) { %><a href="/students" class="btn ghost sm">Clear</a><% } %>
    </form>
  </div>
  <div class="card__body tight">
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr><th>Student ID</th><th>Name</th><th>Course</th><th>Sem</th><th>Branch</th><th>Phone</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% if (!students.length) { %>
            <tr><td colspan="8"><div class="empty"><div class="big">🎓</div><h3>No students found</h3><p>Try adjusting filters or add a new student.</p></div></td></tr>
          <% } %>
          <% students.forEach(function(s){ %>
            <tr>
              <td><a href="/students/<%= s.id %>"><strong><%= s.unique_id %></strong></a></td>
              <td><%= s.name %></td>
              <td><%= s.course_disp || s.course_name || '—' %></td>
              <td><%= s.semester %></td>
              <td><span class="badge indigo"><%= s.branch_code || '—' %></span></td>
              <td class="muted"><%= s.phone || '—' %></td>
              <td>
                <% var sc = s.status==='active'?'green':(s.status==='passed_out'?'blue':'gray'); %>
                <span class="badge <%= sc %>"><%= h.titleCase(s.status) %></span>
              </td>
              <td class="nowrap">
                <a class="icon-btn" href="/students/<%= s.id %>" title="View"><%- icon('eye', 15) %></a>
                <% if (canManage('students')) { %>
                  <a class="icon-btn" href="/students/<%= s.id %>/edit" title="Edit"><%- icon('edit', 15) %></a>
                  <% if (can('collection')) { %><a class="icon-btn" href="/collection?student=<%= s.id %>" title="Collect Fee"><%- icon('money', 15) %></a><% } %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination', { page: page, pages: pages, baseQuery: baseQuery }) %>
  </div>
</div>
