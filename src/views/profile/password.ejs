<div class="page-head">
  <div><div class="breadcrumb"><a href="/profile">Profile</a> / Change password</div><h1>Change Password</h1></div>
</div>

<div class="card" style="max-width:520px;">
  <div class="card__body">
    <% if (currentUser.must_change_password) { %>
      <div class="alert warning"><span>For security, please set a new password before continuing.</span></div>
    <% } %>
    <form action="/profile/password" method="POST">
      <%- csrfField() %>
      <div class="field" style="margin-bottom:14px;"><label>Current password <span class="req">*</span></label><input type="password" name="current_password" required></div>
      <div class="field" style="margin-bottom:14px;"><label>New password <span class="req">*</span></label><input type="password" name="new_password" minlength="6" required><span class="hint">At least 6 characters.</span></div>
      <div class="field" style="margin-bottom:14px;"><label>Confirm new password <span class="req">*</span></label><input type="password" name="confirm_password" minlength="6" required></div>
      <button class="btn"><%- icon('key') %> Update password</button>
    </form>
  </div>
</div>
