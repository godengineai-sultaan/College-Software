<div class="page-head">
  <div>
    <div class="breadcrumb"><a href="/courses">Courses</a> / <%= isEdit ? 'Edit' : 'Add' %></div>
    <h1><%= isEdit ? 'Edit Course' : 'Add Course' %></h1>
  </div>
  <a href="/courses" class="btn secondary"><%- icon('back') %> Cancel</a>
</div>

<form action="<%= isEdit ? '/courses/'+course.id : '/courses' %>" method="POST">
  <%- csrfField() %>
  <div class="card">
    <div class="card__head"><h3>Course Details</h3></div>
    <div class="card__body">
      <div class="form-grid">
        <div class="field"><label>Course Name <span class="req">*</span></label><input name="name" value="<%= course.name || '' %>" required></div>
        <div class="field"><label>Code <span class="req">*</span></label><input name="code" value="<%= course.code || '' %>" required style="text-transform:uppercase;"></div>
        <div class="field"><label>Duration (years)</label><input type="number" name="duration_years" min="1" max="10" value="<%= course.duration_years || 3 %>"></div>
        <div class="field"><label>Total Semesters</label><input type="number" name="total_semesters" min="1" max="20" value="<%= course.total_semesters || 6 %>"></div>
        <div class="field full"><label>Description</label><textarea name="description" placeholder="Optional notes about this course"><%= course.description || '' %></textarea></div>
        <div class="field">
          <label>Status</label>
          <label style="display:flex; align-items:center; gap:8px; font-weight:500;">
            <input type="checkbox" name="is_active" value="1" <%= (course.is_active === undefined || course.is_active) ? 'checked' : '' %> style="width:auto;">
            Active
          </label>
        </div>
      </div>
      <div class="form-actions">
        <button class="btn"><%- icon('save') %> <%= isEdit ? 'Save Changes' : 'Create Course' %></button>
        <a href="/courses" class="btn ghost">Cancel</a>
      </div>
    </div>
  </div>
</form>
