<div class="page-head">
  <div>
    <h1>Expenses</h1>
    <div class="sub"><%= total.toLocaleString('en-IN') %> voucher<%= total === 1 ? '' : 's' %><%= branchScopeId ? ' · Branch ' + currentUser.branch_code : '' %></div>
  </div>
  <div class="btn-group">
    <% if (canManage('expenses')) { %>
      <a href="/expenses/new" class="btn"><%- icon('plus') %> Add Expense</a>
    <% } %>
  </div>
</div>

<!-- KPI tiles -->
<div class="stats">
  <div class="stat"><div class="stat__icon i-red"><%- icon('money',22) %></div><div><div class="stat__val"><%= h.money(totalExpense, currency) %></div><div class="stat__label">Total Expenses<%= (query.category || query.from || query.to || query.q) ? ' (filtered)' : '' %></div></div></div>
  <div class="stat"><div class="stat__icon i-green"><%- icon('fees',22) %></div><div><div class="stat__val"><%= h.money(collectionsTotal, currency) %></div><div class="stat__label">Collections</div></div></div>
  <div class="stat"><div class="stat__icon i-indigo"><%- icon('chart',22) %></div><div><div class="stat__val"><%= h.money(netCollection, currency) %></div><div class="stat__label">Net Collection (Collections − Expenses)</div></div></div>
</div>

<div class="card">
  <div class="card__body" style="padding-bottom:6px;">
    <form class="toolbar" method="GET" action="/expenses">
      <div class="search-box">
        <span class="ic"><%- icon('search', 16) %></span>
        <input type="text" name="q" value="<%= query.q || '' %>" placeholder="Search voucher, paid to, notes...">
      </div>
      <% if (!branchScopeId && branches.length > 1) { %>
        <select name="branch" onchange="this.form.submit()">
          <option value="">All Branches</option>
          <% branches.forEach(function(b){ %><option value="<%= b.id %>" <%= String(query.branch)==String(b.id)?'selected':'' %>>Branch <%= b.branch_code %> — <%= b.name %></option><% }); %>
        </select>
      <% } %>
      <select name="category" onchange="this.form.submit()">
        <option value="">All Categories</option>
        <% categories.forEach(function(c){ %><option value="<%= c %>" <%= query.category===c?'selected':'' %>><%= c %></option><% }); %>
      </select>
      <input type="date" name="from" value="<%= query.from || '' %>" title="From date">
      <input type="date" name="to" value="<%= query.to || '' %>" title="To date">
      <button class="btn secondary sm">Filter</button>
      <% if (query.q || query.category || query.from || query.to || query.branch) { %><a href="/expenses" class="btn ghost sm">Clear</a><% } %>
    </form>
  </div>
  <div class="card__body tight">
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr><th>Voucher No</th><th>Date</th><th>Category</th><th>Paid To</th><th class="text-right">Amount</th><th>Branch</th><th>Bill</th><th></th></tr>
        </thead>
        <tbody>
          <% if (!expenses.length) { %>
            <tr><td colspan="8"><div class="empty"><div class="big">🧾</div><h3>No expenses found</h3><p>Try adjusting filters or add a new expense.</p></div></td></tr>
          <% } %>
          <% expenses.forEach(function(e){ %>
            <tr>
              <td><strong><%= e.voucher_no %></strong></td>
              <td><%= h.formatDate(e.expense_date) %></td>
              <td><%= e.category || '—' %><% if (e.sub_category) { %><br><span class="muted small"><%= e.sub_category %></span><% } %></td>
              <td><%= e.paid_to || '—' %></td>
              <td class="text-right"><strong><%= h.money(e.amount, currency) %></strong></td>
              <td><span class="badge indigo"><%= e.branch_code || '—' %></span></td>
              <td>
                <% if (e.bill_attachment) { %><a href="/uploads/<%= e.bill_attachment %>" target="_blank" rel="noopener" title="View bill"><%- icon('download', 15) %></a><% } else { %><span class="muted">—</span><% } %>
              </td>
              <td class="nowrap">
                <% if (canManage('expenses')) { %>
                  <a class="icon-btn" href="/expenses/<%= e.id %>/edit" title="Edit"><%- icon('edit', 15) %></a>
                  <form action="/expenses/<%= e.id %>/delete" method="POST" data-confirm="Delete voucher <%= e.voucher_no %>? This cannot be undone." style="display:inline;">
                    <%- csrfField() %>
                    <button class="icon-btn danger" title="Delete"><%- icon('trash', 15) %></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination', { page: page, pages: pages, baseQuery: baseQuery }) %>
  </div>
</div>
