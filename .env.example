# ---------------------------------------------------------------------------
# WSchools Fee Management System — environment configuration
# Copy this file to ".env" and adjust the values for your institution.
# ---------------------------------------------------------------------------

# Port the web server listens on
PORT=3000

# "development" while testing, "production" when deploying live.
# In production the server REFUSES to start with default secrets (below).
NODE_ENV=development

# Set to 1 when running behind a reverse proxy (nginx) that terminates TLS,
# so secure cookies and correct client IPs work.
TRUST_PROXY=0

# Secret used to sign login sessions — CHANGE THIS to a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-string

# Path to the SQLite database file (relative to the project root)
DATABASE_FILE=data/college.sqlite

# Default administrator account created during setup.
# CHANGE the password before going live (production refuses the default).
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123

# Optional: encrypt database backups at rest with AES-256-GCM.
# Leave blank to store plain-file backups. Keep this key safe — without it an
# encrypted backup cannot be restored.
BACKUP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Notifications (optional) are configured in the app under Settings →
# Notifications (SMS: Fast2SMS/MSG91, Email: SMTP/SendGrid). No keys are needed
# for the software to run — messages are logged until a gateway is enabled.
# ---------------------------------------------------------------------------
